# ==========================================
# One More Shot - Environment Variables
# ==========================================

# Server Configuration
PORT=3001
PUBLIC_SITE_URL=http://localhost:3001

# Admin Dashboard Authentication (Basic Auth)
ADMIN_USER=admin
ADMIN_PASS=secret123

# Cloudflare R2 Object Storage Credentials (S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET=one-more-shot-uploads
